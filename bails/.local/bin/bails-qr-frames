"""Bounded, fixed-frame BBQr wallet transport. Core watch-only databases preserve wallet state."""

import base64
import io
import json
import math
import os
from pathlib import Path
import re
import selectors
import shutil
import subprocess
import sys
import time
import zlib

MAX_FILE = 1024 * 1024
MAX_PARTS = 256
MAX_FRAME = 4296
FRAME_CHARS = 480  # Complete base32 groups; smaller QRs are easier to scan.
SCAN_SECONDS = 300
ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"


def side_positions(camera, counter, screen):
    """Place adjacent windows inside the screen; move the preview only if needed."""
    x, y, width, height = camera
    _px, _py, pw, ph = counter
    sw, sh = screen
    py = max(48, min(y, sh - ph - 16))
    if x + width + 16 + pw <= sw - 16:
        return None, (x + width + 16, py)
    if x - pw - 16 >= 16:
        return None, (x - pw - 16, py)
    if width + pw + 16 <= sw - 32:
        return (16, y), (16 + width + 16, py)
    px = max(16, min(x, sw - pw - 16))
    if y + height + 16 + ph <= sh - 16:
        return None, (px, y + height + 16)
    if y - ph - 16 >= 48:
        return None, (px, y - ph - 16)
    return None


def position_counter():
    """Best-effort X11 placement using existing xwininfo and EWMH interfaces."""
    if not os.environ.get("DISPLAY") or not shutil.which("xwininfo"):
        return False
    try:
        import ctypes as C
        from ctypes.util import find_library
        library = find_library("X11")
        if not library:
            return False
        env = dict(os.environ, LC_ALL="C")
        tree = subprocess.run(["xwininfo", "-root", "-tree"], env=env,
                              capture_output=True, text=True, timeout=1, check=True).stdout
        candidates = {"camera": [], "counter": []}
        for line in tree.splitlines():
            kind = "counter" if '"Wallet QR transfer"' in line else "camera" if re.search(r'"[^\"]*zbar[^\"]*"', line, re.I) else None
            match = re.search(r'^\s*(0x[0-9a-f]+).*? (\d+)x(\d+)[+-]\d+[+-]\d+\s+([+-]\d+)([+-]\d+)', line, re.I)
            if kind and match:
                wid, w, h, x, y = match.groups()
                candidates[kind].append((int(wid, 16), (int(x), int(y), int(w), int(h))))
        if any(len(items) != 1 for items in candidates.values()):
            return False
        root_info = subprocess.run(["xwininfo", "-root"], env=env,
                                   capture_output=True, text=True, timeout=1, check=True).stdout
        sw = int(re.search(r'Width:\s*(\d+)', root_info)[1])
        sh = int(re.search(r'Height:\s*(\d+)', root_info)[1])
        camera_id, camera = candidates["camera"][0]
        counter_id, counter = candidates["counter"][0]
        positions = side_positions(camera, counter, (sw, sh))
        if positions is None:
            return False
        class Data(C.Union):
            _fields_ = [("l", C.c_long * 5)]
        class Client(C.Structure):
            _fields_ = [("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
                        ("display", C.c_void_p), ("window", C.c_ulong), ("message_type", C.c_ulong),
                        ("format", C.c_int), ("data", Data)]
        class Event(C.Union):
            _fields_ = [("client", Client), ("pad", C.c_long * 24)]
        xlib = C.CDLL(library)
        signatures = {"XOpenDisplay": ([C.c_char_p], C.c_void_p),
                      "XDefaultRootWindow": ([C.c_void_p], C.c_ulong),
                      "XInternAtom": ([C.c_void_p, C.c_char_p, C.c_int], C.c_ulong),
                      "XSendEvent": ([C.c_void_p, C.c_ulong, C.c_int, C.c_long, C.c_void_p], C.c_int),
                      "XFlush": ([C.c_void_p], C.c_int), "XCloseDisplay": ([C.c_void_p], C.c_int)}
        for name, (arguments, result) in signatures.items():
            getattr(xlib, name).argtypes = arguments
            getattr(xlib, name).restype = result
        display = xlib.XOpenDisplay(None)
        if not display:
            return False
        try:
            root = xlib.XDefaultRootWindow(display)
            atom = xlib.XInternAtom(display, b"_NET_MOVERESIZE_WINDOW", False)
            for wid, position in zip((camera_id, counter_id), positions):
                if position is None:
                    continue
                event = Event()
                event.client.type, event.client.send_event = 33, True
                event.client.display, event.client.window = display, wid
                event.client.message_type, event.client.format = atom, 32
                event.client.data.l[0] = (1 << 8) | (1 << 9) | (1 << 12)
                event.client.data.l[1], event.client.data.l[2] = position
                xlib.XSendEvent(display, root, False, (1 << 19) | (1 << 20), C.byref(event))
            xlib.XFlush(display)
        finally:
            xlib.XCloseDisplay(display)
        return True
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, AttributeError):
        # Placement is optional; it must never break QR decoding or cancellation.
        return False


class Cancelled(Exception):
    pass


def stop(process):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def base36(number):
    return ALPHABET[number // 36] + ALPHABET[number % 36]


def encode(data):
    if not data or len(data) > MAX_FILE:
        raise ValueError("Wallet export must be between 1 byte and 1 MiB.")
    compressor = zlib.compressobj(9, zlib.DEFLATED, -10)
    compressed = compressor.compress(data) + compressor.flush()
    encoding, payload = ("Z", compressed) if len(compressed) < len(data) else ("2", data)
    text = base64.b32encode(payload).decode("ascii").rstrip("=")
    count = math.ceil(len(text) / FRAME_CHARS)
    if count > MAX_PARTS:
        raise ValueError("This wallet needs too many QR frames. Use Bitcoin Core file transfer.")
    return [f"B${encoding}J{base36(count)}{base36(i)}" + text[i * FRAME_CHARS:(i + 1) * FRAME_CHARS]
            for i in range(count)]


class Receiver:
    def __init__(self):
        self.header = None
        self.parts = {}
        self.count = 0

    def add(self, frame):
        if not 9 <= len(frame) <= MAX_FRAME or not re.fullmatch(r"B\$[H2Z]J[0-9A-Z]{4}[0-9A-Z]+", frame):
            raise ValueError("Expected a watch-only wallet QR. Show its QR on the other computer.")
        count, index = int(frame[4:6], 36), int(frame[6:8], 36)
        if not 1 <= count <= MAX_PARTS or index >= count:
            raise ValueError("Invalid QR frame number or too many frames.")
        if self.header is not None and frame[:6] != self.header:
            raise ValueError("QR frames belong to different transfers. Scan one wallet at a time.")
        self.header, self.count = frame[:6], count
        text, encoding = frame[8:], frame[2]
        if encoding == "H":
            if not re.fullmatch(r"(?:[0-9A-F]{2})+", text):
                raise ValueError("Invalid hexadecimal QR data.")
            part = bytes.fromhex(text)
        else:
            if not re.fullmatch(r"[A-Z2-7]+", text) or (index < count - 1 and len(text) % 8):
                raise ValueError("Invalid base32 QR data.")
            part = base64.b32decode(text + "=" * (-len(text) % 8))
            if base64.b32encode(part).decode().rstrip("=") != text:
                raise ValueError("Invalid base32 padding bits.")
        if index in self.parts and self.parts[index] != part:
            raise ValueError("Conflicting QR frames. Restart the transfer.")
        self.parts[index] = part
        if len(self.parts) != count:
            return None
        lengths = [len(self.parts[i]) for i in range(count)]
        if count > 1 and (len(set(lengths[:-1])) != 1 or lengths[-1] > lengths[0]):
            raise ValueError("Invalid QR part lengths.")
        data = b"".join(self.parts[i] for i in range(count))
        if encoding == "Z":
            decompressor = zlib.decompressobj(-10)
            data = decompressor.decompress(data, MAX_FILE + 1)
            if len(data) > MAX_FILE or not decompressor.eof or decompressor.unused_data:
                raise ValueError("Incomplete or oversized compressed wallet.")
        if len(data) > MAX_FILE:
            raise ValueError("Wallet setup file is too large.")
        bundle = json.loads(data)
        if not isinstance(bundle, dict) or bundle.get("format") != "bails-watch-only":
            raise ValueError("Expected a Bails watch-only setup file.")
        return data


def gtk_modules():
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import GLib, Gtk
    return GLib, Gtk


def make_png(frame):
    import qrcode
    from qrcode.constants import ERROR_CORRECT_L
    qr = qrcode.QRCode(version=12, error_correction=ERROR_CORRECT_L, box_size=8, border=4)
    qr.add_data(frame, optimize=0)
    qr.make(fit=False)
    png = io.BytesIO()
    qr.make_image().save(png, format="PNG")
    return png.getvalue()


def show(path):
    GLib, Gtk = gtk_modules()
    from gi.repository import Gdk
    with open(path, "rb") as source:
        frames = encode(source.read(MAX_FILE + 1))
    # Build the first frame synchronously. Gtk.Application activation callbacks
    # can otherwise print an exception and leave the caller with a success code.
    Gtk.init()
    loop = GLib.MainLoop()
    window = Gtk.Window(title="Watch-only wallet QR")
    window.set_default_size(520, 640)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, "set_margin_" + side)(16)
    picture = Gtk.Picture()
    picture.set_size_request(320, 320)
    picture.set_can_shrink(True)
    picture.set_hexpand(True)
    picture.set_vexpand(True)
    label = Gtk.Label()
    scope = Gtk.Label(label="Public descriptors and address labels only.\n"
                           "Saved receive-request messages, amounts and dates are not included.",
                      wrap=True)
    close = Gtk.Button(label="Close")
    close.connect("clicked", lambda _button: window.close())
    for child in (picture, label, scope, close):
        box.append(child)
    window.set_child(box)
    index = 0
    cache = {}
    timer = None
    errors = []

    def advance():
        nonlocal index
        if index not in cache:
            cache[index] = Gdk.Texture.new_from_bytes(GLib.Bytes.new(make_png(frames[index])))
            if len(cache) > 8:
                cache.pop(next(iter(cache)))
        picture.set_paintable(cache[index])
        label.set_text(f"Scan on the other computer · QR {index + 1} of {len(frames)}")
        index = (index + 1) % len(frames)

    def tick():
        nonlocal timer
        try:
            advance()
            return True
        except Exception as error:
            errors.append(str(error))
            timer = None
            loop.quit()
            return False

    def closed(_window):
        loop.quit()
        return False

    window.connect("close-request", closed)
    try:
        advance()
        if len(frames) > 1:
            timer = GLib.timeout_add(600, tick)
        window.present()
        loop.run()
    except Exception as error:
        raise ValueError("QR display failed: " + str(error)) from error
    finally:
        if timer is not None:
            GLib.source_remove(timer)
        window.destroy()
    if errors:
        raise ValueError("QR display failed: " + errors[0])


def scan(path):
    receiver = Receiver()
    # BBQr is ASCII, so continuous --raw output has unambiguous newline framing.
    # Keep one camera window open until all parts arrive or the user closes it.
    camera = subprocess.Popen(["zbarcam", "--nodbus", "--raw", "-Sdisable", "-Sqrcode.enable", "-Sbinary"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buffer = bytearray()
    deadline = time.monotonic() + SCAN_SECONDS
    lines = 0
    progress = None
    positioned = False
    next_position = 0.0
    position_deadline = time.monotonic() + 4
    try:
        progress = subprocess.Popen(
            ["zenity", "--progress", "--title=Wallet QR transfer", "--no-markup",
             "--text=Waiting for wallet QR frames…", "--percentage=0",
             "--width=380", "--height=120", "--auto-close"],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, text=True,
            env=dict(os.environ, **({"GDK_BACKEND": "x11"} if os.environ.get("DISPLAY") else {})))
        with selectors.DefaultSelector() as selector:
            selector.register(camera.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if progress.poll() is not None:
                    raise Cancelled()
                now = time.monotonic()
                if not positioned and next_position <= now < position_deadline:
                    positioned = position_counter()
                    next_position = now + 0.2
                if not selector.select(min(1, max(0, deadline - time.monotonic()))):
                    continue
                chunk = os.read(camera.stdout.fileno(), MAX_FRAME + 2)
                if not chunk:
                    if camera.wait() == 0:
                        raise Cancelled()
                    raise ValueError("Wallet scan stopped before all QR frames arrived.")
                buffer.extend(chunk)
                while b"\n" in buffer:
                    frame, _, rest = buffer.partition(b"\n")
                    buffer = bytearray(rest)
                    lines += 1
                    if lines > 8192:
                        raise ValueError("Too many QR frames received. Restart the transfer.")
                    data = receiver.add(frame.decode("ascii"))
                    try:
                        progress.stdin.write(
                            f"# {len(receiver.parts)} of {receiver.count} QR frames received\n"
                            f"{100 * len(receiver.parts) // receiver.count}\n")
                        progress.stdin.flush()
                    except BrokenPipeError:
                        raise Cancelled() from None
                    if data is not None:
                        Path(path).write_bytes(data)
                        return
                if len(buffer) > MAX_FRAME:
                    raise ValueError("QR frame is too large.")
        raise ValueError("Wallet scan timed out. Try again with the camera closer to the screen.")
    finally:
        if progress is not None:
            try:
                progress.stdin.close()
            except BrokenPipeError:
                pass
            try:
                progress.wait(timeout=0.2)
            except subprocess.TimeoutExpired:
                stop(progress)
        stop(camera)
        camera.stdout.close()


def main():
    try:
        if sys.argv[1:] == ["--check"]:
            import qrcode
            gtk_modules()
        elif len(sys.argv) == 3 and sys.argv[1] in ("show", "scan"):
            (show if sys.argv[1] == "show" else scan)(sys.argv[2])
        else:
            raise ValueError("Usage: bails-qr-frames show|scan FILE")
    except Cancelled:
        return 2
    except (ValueError, OSError, ImportError, zlib.error) as error:
        print(str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())

