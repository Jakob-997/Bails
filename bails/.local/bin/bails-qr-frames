"""Bounded BBQr transport for public wallet setup (J) and PSBTs (P)."""

import base64
import io
import json
import math
import os
from pathlib import Path
import re
import selectors
import subprocess
import sys
import time
import zlib

MAX_FILE = 1024 * 1024
MAX_PARTS = 256
MAX_FRAME = 4296
FRAME_CHARS = 480  # Complete base32 groups; smaller QRs are easier to scan.
SCAN_SECONDS = 300
ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
class Cancelled(Exception):
    pass


def stop(process):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def base36(number):
    return ALPHABET[number // 36] + ALPHABET[number % 36]


def encode(data, file_type="J"):
    if file_type not in ("J", "P"):
        raise ValueError("Only wallet JSON and PSBT BBQr transfers are supported.")
    if file_type == "P" and not data.startswith(b"psbt\xff"):
        raise ValueError("Expected a binary PSBT.")
    if not data or len(data) > MAX_FILE:
        raise ValueError("QR transfer must be between 1 byte and 1 MiB.")
    compressor = zlib.compressobj(9, zlib.DEFLATED, -10)
    compressed = compressor.compress(data) + compressor.flush()
    encoding, payload = ("Z", compressed) if len(compressed) < len(data) else ("2", data)
    text = base64.b32encode(payload).decode("ascii").rstrip("=")
    count = math.ceil(len(text) / FRAME_CHARS)
    if count > MAX_PARTS:
        raise ValueError("This transfer needs too many QR frames. Use Bitcoin Core file transfer.")
    return [f"B${encoding}{file_type}{base36(count)}{base36(i)}" + text[i * FRAME_CHARS:(i + 1) * FRAME_CHARS]
            for i in range(count)]


class Receiver:
    def __init__(self, file_type="J"):
        if file_type not in ("J", "P"):
            raise ValueError("Only wallet JSON and PSBT BBQr transfers are supported.")
        self.file_type = file_type
        self.header = None
        self.parts = {}
        self.count = 0

    def add(self, frame):
        if (not 9 <= len(frame) <= MAX_FRAME
                or not re.fullmatch(r"B\$[H2Z][JP][0-9A-Z]{4}[0-9A-Z]+", frame)
                or frame[3] != self.file_type):
            raise ValueError("Expected a PSBT BBQr." if self.file_type == "P" else "Expected a watch-only wallet BBQr.")
        count, index = int(frame[4:6], 36), int(frame[6:8], 36)
        if not 1 <= count <= MAX_PARTS or index >= count:
            raise ValueError("Invalid QR frame number or too many frames.")
        if self.header is not None and frame[:6] != self.header:
            raise ValueError("QR frames belong to different transfers. Scan one transfer at a time.")
        self.header, self.count = frame[:6], count
        text, encoding = frame[8:], frame[2]
        if encoding == "H":
            if not re.fullmatch(r"(?:[0-9A-F]{2})+", text):
                raise ValueError("Invalid hexadecimal QR data.")
            part = bytes.fromhex(text)
        else:
            if not re.fullmatch(r"[A-Z2-7]+", text) or (index < count - 1 and len(text) % 8):
                raise ValueError("Invalid base32 QR data.")
            part = base64.b32decode(text + "=" * (-len(text) % 8))
            if base64.b32encode(part).decode().rstrip("=") != text:
                raise ValueError("Invalid base32 padding bits.")
        if index in self.parts and self.parts[index] != part:
            raise ValueError("Conflicting QR frames. Restart the transfer.")
        self.parts[index] = part
        if len(self.parts) != count:
            return None
        lengths = [len(self.parts[i]) for i in range(count)]
        if count > 1 and (len(set(lengths[:-1])) != 1 or lengths[-1] > lengths[0]):
            raise ValueError("Invalid QR part lengths.")
        data = b"".join(self.parts[i] for i in range(count))
        if encoding == "Z":
            decompressor = zlib.decompressobj(-10)
            data = decompressor.decompress(data, MAX_FILE + 1)
            if len(data) > MAX_FILE or not decompressor.eof or decompressor.unused_data:
                raise ValueError("Incomplete or oversized compressed transfer.")
        if len(data) > MAX_FILE:
            raise ValueError("QR transfer is too large.")
        if self.file_type == "P":
            if not data.startswith(b"psbt\xff"):
                raise ValueError("BBQr PSBT transfer does not contain a binary PSBT.")
        else:
            bundle = json.loads(data)
            if not isinstance(bundle, dict) or bundle.get("format") != "bails-watch-only":
                raise ValueError("Expected a Bails watch-only setup file.")
        return data


def gtk_modules():
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import GLib, Gtk
    return GLib, Gtk


def make_png(frame):
    import qrcode
    from qrcode.constants import ERROR_CORRECT_L
    qr = qrcode.QRCode(version=12, error_correction=ERROR_CORRECT_L, box_size=8, border=4)
    qr.add_data(frame, optimize=0)
    qr.make(fit=False)
    png = io.BytesIO()
    qr.make_image().save(png, format="PNG")
    return png.getvalue()


def show(path, file_type="J"):
    GLib, Gtk = gtk_modules()
    from gi.repository import Gdk
    with open(path, "rb") as source:
        frames = encode(source.read(MAX_FILE + 1), file_type)
    # Build the first frame synchronously. Gtk.Application activation callbacks
    # can otherwise print an exception and leave the caller with a success code.
    Gtk.init()
    loop = GLib.MainLoop()
    window = Gtk.Window(title="Transaction PSBT QR" if file_type == "P" else "Watch-only wallet QR")
    window.set_default_size(520, 640)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, "set_margin_" + side)(16)
    picture = Gtk.Picture()
    picture.set_size_request(320, 320)
    picture.set_can_shrink(True)
    picture.set_hexpand(True)
    picture.set_vexpand(True)
    label = Gtk.Label()
    scope = Gtk.Label(label=("BBQr PSBT · Scan with the other computer."
                            if file_type == "P" else
                            "Public descriptors and address labels only.\n"
                            "Saved receive-request messages, amounts and dates are not included."),
                      wrap=True)
    close = Gtk.Button(label="Close")
    close.connect("clicked", lambda _button: window.close())
    for child in (picture, label, scope, close):
        box.append(child)
    window.set_child(box)
    index = 0
    cache = {}
    timer = None
    errors = []

    def advance():
        nonlocal index
        if index not in cache:
            cache[index] = Gdk.Texture.new_from_bytes(GLib.Bytes.new(make_png(frames[index])))
            if len(cache) > 8:
                cache.pop(next(iter(cache)))
        picture.set_paintable(cache[index])
        label.set_text(f"Scan on the other computer · QR {index + 1} of {len(frames)}")
        index = (index + 1) % len(frames)

    def tick():
        nonlocal timer
        try:
            advance()
            return True
        except Exception as error:
            errors.append(str(error))
            timer = None
            loop.quit()
            return False

    def closed(_window):
        loop.quit()
        return False

    window.connect("close-request", closed)
    try:
        advance()
        if len(frames) > 1:
            timer = GLib.timeout_add(600, tick)
        window.present()
        loop.run()
    except Exception as error:
        raise ValueError("QR display failed: " + str(error)) from error
    finally:
        if timer is not None:
            GLib.source_remove(timer)
        window.destroy()
    if errors:
        raise ValueError("QR display failed: " + errors[0])


def scan_any(path):
    """Scan using only the camera window, retaining binary oneshot framing."""
    camera = None
    try:
        camera = subprocess.Popen(
            ["zbarcam", "--nodbus", "--raw", "-Sdisable", "-Sqrcode.enable", "-Sbinary", "--oneshot"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        first = bytearray()
        deadline = time.monotonic() + 120
        with selectors.DefaultSelector() as selector:
            selector.register(camera.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if not selector.select(0.2):
                    continue
                chunk = os.read(camera.stdout.fileno(), MAX_FRAME + 1)
                if not chunk:
                    if camera.wait() != 0:
                        raise ValueError("No QR code received. Check the camera and try again.")
                    if not first:
                        raise Cancelled()
                    break
                first.extend(chunk)
                if len(first) > MAX_FRAME:
                    raise ValueError("The QR code is too large.")
            else:
                raise ValueError("QR scan timed out. Try again.")
        stop(camera)
        camera.stdout.close()
        camera = None
        if not first or (len(first) > 2953 and not re.match(rb"B\$[H2Z][A-Z]", first)):
            raise ValueError("The QR code is empty or too large.")
        Path(path).write_bytes(first)
        if re.match(rb"B\$[H2Z]P", first):
            scan(path, "P", path)
    finally:
        if camera is not None:
            stop(camera)
            camera.stdout.close()


def scan(path, file_type="J", initial=None):
    receiver = Receiver(file_type)
    if initial is not None:
        with open(initial, "rb") as source:
            first = source.read(MAX_FRAME + 1)
        if len(first) > MAX_FRAME:
            raise ValueError("Initial QR frame is too large.")
        data = receiver.add(first.decode("ascii").rstrip("\r\n"))
        if data is not None:
            Path(path).write_bytes(data)
            return
    # BBQr is ASCII, so continuous --raw output has unambiguous newline framing.
    # Keep one camera window open until all parts arrive or the user closes it.
    camera = subprocess.Popen(["zbarcam", "--nodbus", "--raw", "-Sdisable", "-Sqrcode.enable", "-Sbinary"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buffer = bytearray()
    deadline = time.monotonic() + SCAN_SECONDS
    lines = 0
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(camera.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if not selector.select(min(1, max(0, deadline - time.monotonic()))):
                    continue
                chunk = os.read(camera.stdout.fileno(), MAX_FRAME + 2)
                if not chunk:
                    if camera.wait() == 0:
                        raise Cancelled()
                    raise ValueError("QR scan stopped before all frames arrived.")
                buffer.extend(chunk)
                while b"\n" in buffer:
                    frame, _, rest = buffer.partition(b"\n")
                    buffer = bytearray(rest)
                    lines += 1
                    if lines > 8192:
                        raise ValueError("Too many QR frames received. Restart the transfer.")
                    data = receiver.add(frame.decode("ascii"))
                    if data is not None:
                        Path(path).write_bytes(data)
                        return
                if len(buffer) > MAX_FRAME:
                    raise ValueError("QR frame is too large.")
        raise ValueError("QR scan timed out. Try again with the camera closer to the screen.")
    finally:
        stop(camera)
        camera.stdout.close()


def main():
    try:
        if sys.argv[1:] == ["--check"]:
            import qrcode
            gtk_modules()
        elif len(sys.argv) == 3 and sys.argv[1] in ("show", "scan"):
            (show if sys.argv[1] == "show" else scan)(sys.argv[2])
        elif len(sys.argv) == 3 and sys.argv[1] == "scan-any":
            scan_any(sys.argv[2])
        elif len(sys.argv) == 3 and sys.argv[1] == "show-psbt":
            show(sys.argv[2], "P")
        elif len(sys.argv) in (3, 4) and sys.argv[1] == "scan-psbt":
            scan(sys.argv[2], "P", sys.argv[3] if len(sys.argv) == 4 else None)
        else:
            raise ValueError("Usage: bails-qr-frames show|scan|scan-any|show-psbt FILE, or scan-psbt FILE [FIRST_FRAME]")
    except Cancelled:
        return 2
    except (ValueError, OSError, ImportError, zlib.error) as error:
        print(str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())

