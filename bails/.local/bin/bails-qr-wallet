"""Core watch-only database transfer, with legacy public JSON import."""
import json
import base64
import binascii
from pathlib import Path
import subprocess
import sys

MAX_FILE = 1024 * 1024


def validate(data):
    if len(data) > MAX_FILE:
        raise ValueError("Wallet setup file exceeds 1 MiB.")
    bundle = json.loads(data)
    if (not isinstance(bundle, dict) or bundle.get("format") != "bails-watch-only"
            or bundle.get("version") != 1 or bundle.get("network") not in
            ("main", "test", "testnet4", "signet", "regtest")):
        raise ValueError("Expected a Bails watch-only setup file.")
    descriptors, labels = bundle.get("descriptors"), bundle.get("labels")
    if not isinstance(descriptors, list) or not 1 <= len(descriptors) <= 128:
        raise ValueError("Invalid descriptor list.")
    for item in descriptors:
        if (not isinstance(item, dict) or set(item) - {"desc", "timestamp", "active", "internal", "range", "next_index"}
                or not isinstance(item.get("desc"), str)
                or type(item.get("timestamp")) is not int or item["timestamp"] < 0
                or type(item.get("active")) is not bool):
            raise ValueError("Invalid public descriptor metadata.")
        if "internal" in item and type(item["internal"]) is not bool:
            raise ValueError("Invalid descriptor branch.")
        if "range" in item:
            bounds = item["range"]
            if (not isinstance(bounds, list) or len(bounds) != 2
                    or any(type(n) is not int for n in bounds)
                    or not 0 <= bounds[0] <= bounds[1] <= 1000000):
                raise ValueError("Invalid descriptor address range.")
        if "next_index" in item and (type(item["next_index"]) is not int
                                     or not 0 <= item["next_index"] <= 1000000):
            raise ValueError("Invalid next address index.")
    if not isinstance(labels, list) or len(labels) > 10000:
        raise ValueError("Invalid address-label list.")
    seen = set()
    for item in labels:
        if (not isinstance(item, dict) or set(item) != {"type", "ref", "label"}
                or item["type"] != "addr" or not isinstance(item["ref"], str)
                or not isinstance(item["label"], str) or item["ref"] in seen):
            raise ValueError("Invalid or duplicate address label.")
        seen.add(item["ref"])
    return bundle


def transfer(action, path, wallet, flags):
    def rpc(method, *args, selected=None):
        command = ["bitcoin-cli", *flags]
        if selected is not None:
            command.append("-rpcwallet=" + selected)
        if method in ("importdescriptors", "getdescriptorinfo"):
            command.extend(["-stdin", method])
            result = subprocess.run(command, input=args[0] + "\n", text=True, capture_output=True)
        else:
            result = subprocess.run([*command, method, *args], text=True, capture_output=True)
        if result.returncode:
            raise ValueError("Bitcoin Core: " + result.stderr.strip()[:1500])
        return json.loads(result.stdout) if result.stdout.strip() else None

    network = rpc("getblockchaininfo")["chain"]
    if action == "address":
        info = rpc("getaddressinfo", path, selected=wallet)
        if not (info.get("ismine") or info.get("iswatchonly")):
            print("Address does NOT belong to the selected wallet:\n" + path)
            return
        status = rpc("getwalletinfo", selected=wallet)
        message = "Address belongs to the selected wallet:\n" + path + "\n\n"
        if status.get("private_keys_enabled") is False:
            message += "Private keys: No. This is a watch-only wallet; it cannot sign or spend."
        elif status.get("unlocked_until") == 0:
            message += "Private keys: Not checked. Unlock this wallet in Bitcoin Core and scan again."
        elif status.get("descriptors") and not info.get("parent_desc"):
            message += "Private keys: Not checked. Core did not identify the parent descriptor for this address."
        elif status.get("descriptors"):
            parent = info.get("parent_desc")
            found = False
            for item in rpc("listdescriptors", "true", selected=wallet)["descriptors"]:
                details = rpc("getdescriptorinfo", item["desc"])
                if details["descriptor"] == parent and details["hasprivatekeys"]:
                    found = True
                    break
            if found:
                message += ("Private keys: Yes, this wallet has signing key material for this address. "
                            "Multisig or other spending conditions may require additional keys or conditions.")
            else:
                message += "Private keys: No signing key found for this address. It is watch-only in this wallet."
        elif info.get("ismine") and not info.get("iswatchonly"):
            message += "Private keys: Yes, Bitcoin Core identifies this address as spendable by this wallet."
        else:
            message += "Private keys: No. This address is watch-only in this wallet."
        print(message + "\n\nThis does not verify a payment amount or an available balance.")
        return
    if action == "export":
        # Never copy/backup the signing wallet: Core strips its private keys.
        database = Path(path).with_suffix(".core.dat")
        try:
            rpc("exportwatchonlywallet", str(database.resolve()), selected=wallet)
            with database.open("rb") as source:
                raw = source.read(MAX_FILE + 1)
            if not raw.startswith(b"SQLite format 3\0"):
                raise ValueError("Core did not export a SQLite watch-only wallet.")
            data = json.dumps({"format": "bails-watch-only", "version": 2, "network": network,
                               "wallet": base64.b64encode(raw).decode("ascii")},
                              separators=(",", ":")).encode()
            if len(data) > MAX_FILE:
                raise ValueError("Watch-only wallet export exceeds the 1 MiB QR limit.")
            Path(path).write_bytes(data)
        finally:
            database.unlink(missing_ok=True)
        return

    with open(path, "rb") as source:
        data = source.read(MAX_FILE + 1)
    if len(data) > MAX_FILE:
        raise ValueError("Wallet export exceeds 1 MiB.")
    bundle = json.loads(data)
    if isinstance(bundle, dict) and bundle.get("format") == "bails-watch-only" and bundle.get("version") == 2:
        if bundle.get("network") != network:
            raise ValueError("Wallet setup belongs to a different Bitcoin network.")
        try:
            raw = base64.b64decode(bundle["wallet"], validate=True)
        except (binascii.Error, KeyError, TypeError):
            raise ValueError("Invalid watch-only wallet database encoding.") from None
        if not raw.startswith(b"SQLite format 3\0"):
            raise ValueError("Expected a Core watch-only wallet database.")
        database = Path(path).with_suffix(".received.dat")
        try:
            database.write_bytes(raw)
            rpc("restorewallet", wallet, str(database.resolve()), "false")
        finally:
            database.unlink(missing_ok=True)
        try:
            if rpc("getwalletinfo", selected=wallet).get("private_keys_enabled") is not False:
                raise ValueError("Received wallet is not watch-only; refusing to use it.")
            if any(rpc("getdescriptorinfo", item["desc"])["hasprivatekeys"]
                   for item in rpc("listdescriptors", "true", selected=wallet)["descriptors"]):
                raise ValueError("Received wallet contains private keys; refusing to use it.")
        except (ValueError, KeyError, TypeError):
            rpc("unloadwallet", wallet, "false")
            raise
        return
    bundle = validate(data)
    if bundle["network"] != network:
        raise ValueError("Wallet setup belongs to a different Bitcoin network.")
    for item in bundle["descriptors"]:
        if rpc("getdescriptorinfo", item["desc"])["hasprivatekeys"]:
            raise ValueError("Wallet setup contains private keys; refusing import.")
    for item in bundle["labels"]:
        if not rpc("validateaddress", item["ref"])["isvalid"]:
            raise ValueError("Wallet setup contains an invalid address.")
    # A fresh wallet prevents overwriting or mixing another wallet's labels.
    rpc("createwallet", wallet, "true", "true", "", "false", "true", "true")
    requests = json.dumps(bundle["descriptors"], separators=(",", ":"))
    results = rpc("importdescriptors", requests, selected=wallet)
    if not all(item.get("success") is True for item in results):
        raise ValueError("Descriptor import incomplete. Check the new wallet in Core; historical blocks may be unavailable.")
    for item in bundle["labels"]:
        rpc("setlabel", item["ref"], item["label"], selected=wallet)


if __name__ == "__main__":
    try:
        if len(sys.argv) < 4 or sys.argv[1] not in ("export", "import", "address"):
            raise ValueError("Usage: bails-qr-wallet export|import|address FILE_OR_ADDRESS WALLET [CORE FLAGS]")
        transfer(*sys.argv[1:4], sys.argv[4:])
    except (ValueError, OSError, KeyError, TypeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)

