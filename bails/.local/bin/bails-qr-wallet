"""Compact public wallet setup and conservative all-wallet address checks."""
import json
import base64
import binascii
import re
import signal
from pathlib import Path
import subprocess
import sys

MAX_FILE = 1024 * 1024


def key_status(rpc, address, wallet, info):
    status = rpc("getwalletinfo", selected=wallet)
    if status.get("private_keys_enabled") is False:
        return "✗ Cannot spend locally: watch-only (private keys disabled)."
    if status.get("blank") is True:
        return "Key status not verified: wallet is marked blank."
    parent = info.get("parent_desc")
    if not status.get("descriptors") or not parent:
        return "Key status not verified: no parent descriptor reported."
    try:
        # Both RPCs obtain this descriptor through Core's GetDescriptorString.
        # Do not canonicalize a private descriptor: normalized account xpubs
        # need not have the same representation as the wallet's stored key.
        keys = rpc("gethdkeys", selected=wallet)
        related = [key for key in keys if any(item.get("desc") == parent
                   for item in key.get("descriptors", []))]
        expression = parent.split("#", 1)[0]
        if expression.startswith("sh(wpkh(") and expression.endswith("))"):
            expression = expression[3:-1]
        match = re.fullmatch(
            r"(?:pkh|wpkh|tr)\((?:\[[0-9a-fA-F]{8}(?:/[0-9]+[h']?)*\])?"
            r"((?:xpub|tpub)[1-9A-HJ-NP-Za-km-z]+)(?:/[0-9]+)*(\/\*)?\)", expression)
        if not match:
            if any(key.get("has_private") is True for key in related):
                return "Signing HD key(s) reported for this descriptor; additional keys or spending conditions may be required. Full spending ability not verified."
            return "Key status not verified: descriptor is outside the supported single-key HD checks."
        # gethdkeys lists the stored master xpub, while parent_desc can contain
        # the account xpub after hardened derivation. Core supplies the exact
        # key-to-descriptor association; those xpub strings need not be equal.
        # A supported descriptor has one HD key, so require one inventory match.
        if len(related) != 1 or not isinstance(related[0].get("xpub"), str) or related[0].get("has_private") is not True:
            return "Key status not verified: Core did not confirm the corresponding private HD key."
        arguments = []
        if match[2]:
            path = info.get("hdkeypath", "")
            index = path.rsplit("/", 1)[-1]
            if not index.isascii() or not index.isdecimal() or not 0 <= int(index) < 2**31:
                return "Key status not verified: missing or unsupported address derivation index."
            arguments.append(json.dumps([int(index), int(index)]))
        # Independently tie the stored descriptor/key to the exact scanned address.
        # Core's GUI deliberately uppercases Bech32 addresses in BIP21 QRs.
        # getaddressinfo re-encodes the validated destination canonically;
        # never lowercase arbitrary addresses (Base58 is case-sensitive).
        canonical = info.get("address")
        if not isinstance(canonical, str) or rpc("deriveaddresses", parent, *arguments) != [canonical]:
            return "Key status not verified: derived address did not match the scanned address."
        suffix = " Wallet is locked; unlock in Core to sign." if status.get("unlocked_until") == 0 else ""
        return "✓ This wallet has the key needed to spend from this address." + suffix
    except (ValueError, KeyError, TypeError):
        return "Key status not verified: Core could not complete the HD-key check."


def address_report(rpc, address, wallet):
    info = rpc("getaddressinfo", address, selected=wallet)
    if not (info.get("ismine") is True or info.get("iswatchonly") is True):
        return None
    signing = key_status(rpc, address, wallet, info)
    if not signing.startswith(("✓", "✗")):
        signing = "⚠ " + signing
    report = ("Wallet: " + json.dumps(wallet, ensure_ascii=False)
              + "\nAddress ownership: confirmed by Bitcoin Core.\n" + signing)
    if re.search(r"(?:sorted)?multi(?:_a)?\(", info.get("parent_desc", "")):
        report += "\n⚠ Multisig policy: this wallet may not hold all required signing keys. Additional signers may be required."
    return report


def search_wallets(rpc, address, progress=lambda _message: None):
    if rpc("validateaddress", address).get("isvalid") is not True:
        raise ValueError("Bitcoin Core rejected this address for the current network.")
    loaded = rpc("listwallets")
    matches, errors = [], []
    names = list(dict.fromkeys([*loaded, *(item["name"] for item in rpc("listwalletdir")["wallets"])]))
    for name in names:
        opened = False
        progress("Checking wallet " + json.dumps(name, ensure_ascii=False))
        try:
            if name not in loaded:
                # Omit load_on_startup: null preserves existing startup preferences.
                rpc("loadwallet", name)
                opened = True
            report = address_report(rpc, address, name)
            if report:
                matches.append(report)
        except (ValueError, KeyError, TypeError) as error:
            errors.append("Could not check " + json.dumps(name, ensure_ascii=False) + ": " + str(error))
        finally:
            if opened:
                try:
                    rpc("unloadwallet", name)
                except ValueError as error:
                    errors.append("Could not unload " + json.dumps(name, ensure_ascii=False) + ": " + str(error))
    heading = "Address belongs to the following wallet(s):" if matches else "No matching wallet found among the wallets successfully checked."
    text = heading + "\n" + address + "\n\n" + "\n\n".join(matches)
    if errors:
        text += "\n\nIncomplete check:\n" + "\n".join(errors)
    return text + "\n\nKey status relies on Core's key inventory and public derivation. No signing test was performed; payment amounts and balances are not checked."


def validate(data):
    if len(data) > MAX_FILE:
        raise ValueError("Wallet setup file exceeds 1 MiB.")
    bundle = json.loads(data)
    if (not isinstance(bundle, dict) or bundle.get("format") != "bails-watch-only"
            or bundle.get("version") != 1 or bundle.get("network") not in
            ("main", "test", "testnet4", "signet", "regtest")):
        raise ValueError("Expected a Bails watch-only setup file.")
    descriptors, labels = bundle.get("descriptors"), bundle.get("labels")
    if not isinstance(descriptors, list) or not 1 <= len(descriptors) <= 128:
        raise ValueError("Invalid descriptor list.")
    for item in descriptors:
        if (not isinstance(item, dict) or set(item) - {"desc", "timestamp", "active", "internal", "range", "next_index"}
                or not isinstance(item.get("desc"), str)
                or type(item.get("timestamp")) is not int or item["timestamp"] < 0
                or type(item.get("active")) is not bool):
            raise ValueError("Invalid public descriptor metadata.")
        if "internal" in item and type(item["internal"]) is not bool:
            raise ValueError("Invalid descriptor branch.")
        if "range" in item:
            bounds = item["range"]
            if (not isinstance(bounds, list) or len(bounds) != 2
                    or any(type(n) is not int for n in bounds)
                    or not 0 <= bounds[0] <= bounds[1] <= 1000000):
                raise ValueError("Invalid descriptor address range.")
        if "next_index" in item and (type(item["next_index"]) is not int
                                     or not 0 <= item["next_index"] <= 1000000):
            raise ValueError("Invalid next address index.")
    if not isinstance(labels, list) or len(labels) > 10000:
        raise ValueError("Invalid address-label list.")
    seen = set()
    for item in labels:
        if (not isinstance(item, dict) or set(item) != {"type", "ref", "label"}
                or item["type"] != "addr" or not isinstance(item["ref"], str)
                or not isinstance(item["label"], str) or item["ref"] in seen):
            raise ValueError("Invalid or duplicate address label.")
        seen.add(item["ref"])
    return bundle


def transfer(action, path, wallet, flags):
    def rpc(method, *args, selected=None):
        command = ["bitcoin-cli", *flags]
        if selected is not None:
            command.append("-rpcwallet=" + selected)
        if method in ("importdescriptors", "getdescriptorinfo"):
            command.extend(["-stdin", method])
            result = subprocess.run(command, input=args[0] + "\n", text=True, capture_output=True)
        else:
            result = subprocess.run([*command, method, *args], text=True, capture_output=True)
        if result.returncode:
            raise ValueError("Bitcoin Core: " + result.stderr.strip()[:1500])
        return json.loads(result.stdout) if result.stdout.strip() else None

    network = rpc("getblockchaininfo")["chain"]
    if action == "address-all":
        report = search_wallets(rpc, path, lambda message: print("# " + message, flush=True))
        Path(wallet).write_text(report, encoding="utf-8")
        print("100", flush=True)
        return
    if action == "address":
        report = address_report(rpc, path, wallet)
        print(report if report else "Address does NOT belong to the selected wallet:\n" + path)
        return
    if action == "export":
        descriptors = rpc("listdescriptors", "false", selected=wallet)["descriptors"]
        descriptors = [{key: value for key, value in item.items() if key != "next"}
                       for item in descriptors]
        labels = []
        for label in rpc("listlabels", selected=wallet):
            addresses = rpc("getaddressesbylabel", label, selected=wallet)
            labels.extend({"type": "addr", "ref": address, "label": label} for address in addresses)
        bundle = {"format": "bails-watch-only", "version": 1, "network": network,
                  "descriptors": descriptors, "labels": labels}
        data = json.dumps(bundle, ensure_ascii=False, separators=(",", ":")).encode()
        validate(data)
        for item in descriptors:
            if rpc("getdescriptorinfo", item["desc"])["hasprivatekeys"]:
                raise ValueError("Core returned a private descriptor; refusing export.")
        Path(path).write_bytes(data)
        return

    with open(path, "rb") as source:
        data = source.read(MAX_FILE + 1)
    if len(data) > MAX_FILE:
        raise ValueError("Wallet export exceeds 1 MiB.")
    bundle = json.loads(data)
    if isinstance(bundle, dict) and bundle.get("format") == "bails-watch-only" and bundle.get("version") == 2:
        if bundle.get("network") != network:
            raise ValueError("Wallet setup belongs to a different Bitcoin network.")
        try:
            raw = base64.b64decode(bundle["wallet"], validate=True)
        except (binascii.Error, KeyError, TypeError):
            raise ValueError("Invalid watch-only wallet database encoding.") from None
        if not raw.startswith(b"SQLite format 3\0"):
            raise ValueError("Expected a Core watch-only wallet database.")
        database = Path(path).with_suffix(".received.dat")
        try:
            database.write_bytes(raw)
            rpc("restorewallet", wallet, str(database.resolve()), "false")
        finally:
            database.unlink(missing_ok=True)
        try:
            if rpc("getwalletinfo", selected=wallet).get("private_keys_enabled") is not False:
                raise ValueError("Received wallet is not watch-only; refusing to use it.")
            if any(rpc("getdescriptorinfo", item["desc"])["hasprivatekeys"]
                   for item in rpc("listdescriptors", "true", selected=wallet)["descriptors"]):
                raise ValueError("Received wallet contains private keys; refusing to use it.")
        except (ValueError, KeyError, TypeError):
            rpc("unloadwallet", wallet, "false")
            raise
        return
    bundle = validate(data)
    if bundle["network"] != network:
        raise ValueError("Wallet setup belongs to a different Bitcoin network.")
    for item in bundle["descriptors"]:
        if rpc("getdescriptorinfo", item["desc"])["hasprivatekeys"]:
            raise ValueError("Wallet setup contains private keys; refusing import.")
    for item in bundle["labels"]:
        if not rpc("validateaddress", item["ref"])["isvalid"]:
            raise ValueError("Wallet setup contains an invalid address.")
    # A fresh wallet prevents overwriting or mixing another wallet's labels.
    rpc("createwallet", wallet, "true", "true", "", "false", "true", "true")
    requests = json.dumps(bundle["descriptors"], separators=(",", ":"))
    results = rpc("importdescriptors", requests, selected=wallet)
    if not all(item.get("success") is True for item in results):
        raise ValueError("Descriptor import incomplete. Check the new wallet in Core; historical blocks may be unavailable.")
    for item in bundle["labels"]:
        rpc("setlabel", item["ref"], item["label"], selected=wallet)


if __name__ == "__main__":
    def interrupted(_signum, _frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, interrupted)
    try:
        if len(sys.argv) < 4 or sys.argv[1] not in ("export", "import", "address", "address-all"):
            raise ValueError("Usage: bails-qr-wallet export|import|address|address-all FILE_OR_ADDRESS WALLET_OR_REPORT [CORE FLAGS]")
        transfer(*sys.argv[1:4], sys.argv[4:])
    except (ValueError, OSError, KeyError, TypeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)

